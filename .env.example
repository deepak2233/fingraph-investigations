DATABASE_URL=postgresql+psycopg://fingraph:localdev@localhost:5432/fingraph
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fingraph.cases.v1
# Configure the issuer, audience and JWKS endpoint for private /api/v1 routes.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Claims must contain sub, tenant_id and roles (ingest, analyst, reviewer).
# Set projection options on the pipeline.projector process.
NEPTUNE_ENDPOINT=
AWS_REGION=us-east-1
GRAPH_EXPORT_DIR=var/graphs

digraph FinGraph {
  graph [rankdir=TB, bgcolor="#f7faf8", pad="0.25", nodesep="0.35", ranksep="0.5", fontname="Arial", newrank=true];
  node [shape=box, style="rounded,filled", color="#b5cfc0", fillcolor="white", fontname="Arial", fontsize=13, margin="0.14,0.1"];
  edge [color="#729a84", arrowsize=0.7, fontname="Arial", fontsize=11];

  subgraph cluster_workbench {
    label="Vercel workbench";
    color="#c9dbd0";
    style=rounded;
    ui [label="FastAPI and browser UI\nFive authored cases"];
    demo [label="On-request RDF + SHACL + SPARQL\nDeterministic investigation draft"];
    score [label="Sampled model inference\nExported weights and features"];
    ui -> demo;
    ui -> score;
  }
  subgraph cluster_durable {
    label="Durable case service";
    color="#c9dbd0";
    style=rounded;
    rules [label="Canonical snapshot\nFan-out and three-account cycle"];
    intake [label="Kafka worker / OIDC intake\nTenant-scoped event"];
    service [label="InvestigationService\nSHACL, evidence and draft"];
    sql [label="PostgreSQL\nCase, audit and outbox", fillcolor="#dff0e6"];
    review [label="OIDC reviewer\nVersioned review"];
    projection [label="Independent RDF projection\nLocal files or Neptune adapter"];
    rules -> intake -> service -> sql;
    sql -> review;
    sql -> projection [label="outbox"];
  }
  subgraph cluster_benchmark {
    label="Offline AMLworld benchmark";
    color="#c4d4df";
    style=rounded;
    ledger [label="Complete ledger\n5,078,345 synthetic transfers"];
    features [label="Rolling event-minute features\nBehavior and directed graph"];
    ranking [label="Two temporal holdouts\nGradient boosting ranks sender-days"];
    shadow [label="Same InvestigationService\nThree model-ranked cases in SQLite"];
    report [label="Metrics and handoff report\nDisplayed in Model Lab", fillcolor="#e4eef6"];
    ledger -> features -> ranking -> shadow -> report;
  }

  { rank=same; ui; rules; ledger; }
}
